# Maintainer: Copyzer Contributors
pkgname=copyzer
pkgver=0.3.0
pkgrel=1
pkgdesc="Fast, keyboard-first iPhone media copier TUI/CLI for Arch Linux and Omarchy"
arch=('x86_64' 'aarch64')
url="https://github.com/phaze7r/copyzer"
license=('MIT')
depends=('ifuse' 'libimobiledevice' 'usbmuxd')
makedepends=('cargo')
optdepends=('xdg-terminal-exec: launch TUI from desktop entry')
options=('!lto')

build() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

package() {
  cd "$startdir/.."
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "pkgbuild/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "pkgbuild/$pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 "pkgbuild/copyzer-usb-a.conf" "$pkgdir/usr/lib/modprobe.d/copyzer-usb-a.conf"
  install -Dm644 "pkgbuild/90-copyzer-iphone.rules" "$pkgdir/usr/lib/udev/rules.d/90-copyzer-iphone.rules"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
